# Blog API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# HTTP listen port for the API.
APP_PORT=8080

# MySQL data source name. `parseTime=true` is required so TIMESTAMP columns
# scan into time.Time. Required.
# Local (manual) setup example:
DB_DSN=root:abc123@tcp(127.0.0.1:3333)/appdb?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
# Docker Compose overrides DB_DSN to point at the `db` service.

# JWT signing secret. Required, at least 32 bytes. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-random-bytes

# Issued token lifetime (Go duration syntax). Defaults to 24h.
JWT_TTL=24h

# Directory containing *.up.sql migrations, relative to the working directory
# of the migrate command. Defaults to "migrations".
MIGRATIONS_DIR=migrations

{
  "info": {
    "name": "Blog API",
    "description": "Blog REST API — users, posts, comments with JWT auth.\n\nQuick start:\n1. Start MySQL, apply migrations (cd app && go run ./cmd/migrate), start the API (go run ./cmd/api).\n2. Run \"Register\", then \"Login\" — the bearer token is saved automatically to the {{token}} collection variable.\n3. Protected requests (create/update/delete post, create comment) use {{token}} automatically. Public requests are explicitly No Auth, so they prove they work without a token.\n4. \"Create post\" stores the new post id in {{post_id}}; every request that needs a post uses it.\n\nSuggested order: Health → Auth → Posts → Comments → Cleanup → Negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "page",
      "value": "1",
      "type": "string"
    },
    {
      "key": "limit",
      "value": "10",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or 503\", () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "pm.test(\"body is a JSON envelope\", () => { const b = pm.response.json(); pm.expect(Boolean(b.data || b.error)).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Public. 200 {\"data\":{\"status\":\"ok\"}} while MySQL is reachable; 503 with an error envelope when the ping fails."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 (or 409 if the email is already registered)\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Public. 201 with the created user. 409 CONFLICT when the email is taken (expected on re-runs). 400 VALIDATION_ERROR for bad name/email/password."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Public. 200 {\"data\":{\"token\":\"...\",\"token_type\":\"Bearer\",\"expires_in\":86400}}. The token is saved to {{token}} automatically. Wrong password or unknown email → 401 UNAUTHORIZED."
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"post_id\", String(pm.response.json().data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"First post\",\n  \"content\": \"Hello from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Protected (Bearer {{token}}). Creates a post owned by the logged-in user; the new id is saved to {{post_id}}. 401 without a token; 400 for empty/oversized title or content."
          }
        },
        {
          "name": "List posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts?page={{page}}&limit={{limit}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "Public. Paginated envelope: {\"data\":[...],\"pagination\":{\"page\":1,\"limit\":10,\"total\":N}}. Both params may be omitted (defaults 1/10); a present param must be in range — ?limit=0 or ?page=0 → 400 VALIDATION_ERROR."
          }
        },
        {
          "name": "Get post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Public. A missing post id → 404 NOT_FOUND."
          }
        },
        {
          "name": "Update post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Protected. Only the author may update: another user's post → 403 FORBIDDEN, missing post → 404 NOT_FOUND. Sending identical values still returns 200."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Nice post!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}",
                "comments"
              ]
            },
            "description": "Protected. author_id comes from the token and author_name is a server-side snapshot — anything like them in the body is ignored. Unknown post → 404 NOT_FOUND."
          }
        },
        {
          "name": "List comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}/comments?page={{page}}&limit={{limit}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}",
                "comments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "Public. Paginated like GET /posts. Unknown post → 404 NOT_FOUND."
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Protected. 204 on success (no body). Only the author may delete: another user's post → 403 FORBIDDEN, missing post → 404 NOT_FOUND."
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "Register — password too short",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"exact message\", () => pm.expect(pm.response.json().error.message).to.eql(\"Password must be at least 8 characters.\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi\",\n  \"email\": \"invalid@example.com\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Password boundary: 8–15 characters, letters and digits only. This one is 5 characters → 400 with the exact user-facing message."
          }
        },
        {
          "name": "Register — password with symbol",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"exact message\", () => pm.expect(pm.response.json().error.message).to.eql(\"Password can only contain letters and numbers.\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi\",\n  \"email\": \"invalid@example.com\",\n  \"password\": \"secret!123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "10 characters but contains '!' → 400 with the exact user-facing message."
          }
        },
        {
          "name": "List posts — limit=0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts?limit=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "0"
                }
              ]
            },
            "description": "Strict pagination: a present limit must be 1–100 (and page ≥ 1). ?limit=0 is rejected, never silently defaulted."
          }
        },
        {
          "name": "Create post — no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is UNAUTHORIZED\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHORIZED\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"No token\",\n  \"content\": \"Should be rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "No Auth is set explicitly on this request, so no Authorization header is sent → 401 UNAUTHORIZED."
          }
        },
        {
          "name": "Get missing post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code is NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "999999"
              ]
            },
            "description": "A resource that does not exist → 404 with the same NOT_FOUND envelope as an unknown route."
          }
        }
      ]
    }
  ]
}
